{
  "name": "obralocal-ai",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "postinstall": "node scripts/sync-assets.mjs",
    "dev": "npm run sync:assets && vite --mode web",
    "build": "tsc --noEmit && npm run sync:assets && vite build --mode web",
    "build:capacitor": "tsc --noEmit && npm run sync:assets && vite build --mode capacitor && npx cap sync",
    "release:android": "node scripts/build-android-release.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.0",
    "@capgo/capacitor-llm": "^7.2.15",
    "@capgo/capacitor-speech-recognition": "^7.2.3",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@langchain/core": "^0.3.50",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/langgraph-checkpoint": "^0.0.18",
    "@mediapipe/tasks-genai": "^0.10.22",
    "@sqlite.org/sqlite-wasm": "^3.49.1-build4",
    "@tesseract.js-data/spa": "^1.0.0",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.2.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "better-sqlite3@12.11.1": true
  }
}
